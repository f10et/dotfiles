#!/usr/bin/env bash
#
# Run installers for enabled or requested dotfiles modules.

set -euo pipefail

cd "$(dirname "$0")/.."

source script/lib/modules.sh

modules=()
while IFS= read -r module; do
  [ -n "$module" ] && modules+=("$module")
done < <(dotfiles_resolve_modules "$@")

for module in "${modules[@]}"; do
  installer="$DOTFILES_ROOT/$module/install.sh"

  if [ -f "$installer" ]; then
    echo "› install $module"
    (cd "$DOTFILES_ROOT" && sh "$installer")
  fi
done
