export ZSH="${ZSH:-$HOME/.dotfiles}"
export DOTFILES="$ZSH"

if (( $+commands[brew] )); then
  export HOMEBREW_PREFIX="$(brew --prefix)"
  export HOMEBREW_PATH="$HOMEBREW_PREFIX/opt"
else
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_PATH="/opt/homebrew/opt"
fi


if [ "$(uname -s)" = "Darwin" ]; then
 
else
  # Linux
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
fi


dotfiles_enabled_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/enabled"

typeset -U dotfiles_modules
if [ -f "$dotfiles_enabled_file" ]; then
  dotfiles_modules=("${(@f)$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$dotfiles_enabled_file")}")
else
  dotfiles_modules=(system zsh git vim ruby go node yarn docker macos xcode)
fi

dotfiles_source() {
  local file

  for file in "$@"; do
    [ -f "$file" ] && source "$file"
  done
}

for module in "${dotfiles_modules[@]}"; do
  dotfiles_source "$ZSH/$module"/path.zsh(N) "$ZSH/$module"/_path.zsh(N)
done

for module in "${dotfiles_modules[@]}"; do
  for file in "$ZSH/$module"/*.zsh(N); do
    case "$file" in
      */path.zsh|*/_path.zsh|*/completion.zsh) continue ;;
    esac

    dotfiles_source "$file"
  done
done

autoload -U compinit
compinit

for module in "${dotfiles_modules[@]}"; do
  dotfiles_source "$ZSH/$module"/completion.zsh(N)
done

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

unset dotfiles_enabled_file dotfiles_modules
unfunction dotfiles_source
